meta {
  name: modificar perfil
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "Nombre": "Carlos",
      "Apellido1": "Administrado",
      "Apellido2": "López",
      "Telefono": "600123456",
      "Direccion": "Calle Mayor 10",
      "Email": "admin@peluqueria.com",
      "Notas": "Perfil actualizado desde Bruno"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
